---
import Base from '../layouts/Base.astro';
import PhotoItem from '../components/PhotoItem.astro';
import { getPhotos } from '../lib/photos';

const photos = await getPhotos();
---

<Base>
  <section class="gallery" id="gallery">
    {photos.map((photo, i) => <PhotoItem photo={photo} eager={i < 6} />)}
  </section>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // 底部抽屉收起时露出的高度，同时给照片底部留出同样的空间，避免挡住画面
  const PEEK_HEIGHT = 64;

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery',
    children: 'a.photo',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.95,
    wheelToZoom: true,
    showHideAnimationType: 'zoom',
    // 全屏时抽屉完全隐藏，照片占满整个屏幕
    paddingFn: () => ({ top: 0, bottom: document.fullscreenElement ? 0 : PEEK_HEIGHT, left: 0, right: 0 }),
  });

  const toggleFullscreen = () => {
    const request = document.fullscreenElement
      ? document.exitFullscreen()
      : document.documentElement.requestFullscreen();
    request.catch(() => {});
  };

  lightbox.on('uiRegister', () => {
    // 浏览器全屏：工具栏按钮 + F 键。iPhone 上的 Safari 不支持网页全屏，此时不显示按钮
    if (document.fullscreenEnabled) {
      lightbox.pswp?.ui?.registerElement({
        name: 'fullscreen-button',
        title: '全屏 (F)',
        ariaLabel: '全屏',
        order: 15,
        isButton: true,
        html: `<svg class="pswp__icn" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
          <path class="fs-enter" d="M8 14V8h6v2h-4v4H8zm10-6h6v6h-2v-4h-4V8zM8 18h2v4h4v2H8v-6zm14 0h2v6h-6v-2h4v-4z"/>
          <path class="fs-exit" d="M12 8h2v6H8v-2h4V8zm6 0h2v4h4v2h-6V8zM8 18h6v6h-2v-4H8v-2zm10 0h6v2h-4v4h-2v-6z"/>
        </svg>`,
        onClick: toggleFullscreen,
        onInit: (el, pswp) => {
          const sync = () => {
            el.classList.toggle('is-active', !!document.fullscreenElement);
            pswp.updateSize(true);
          };
          sync();
          document.addEventListener('fullscreenchange', sync);
          pswp.on('destroy', () => document.removeEventListener('fullscreenchange', sync));
          pswp.on('keydown', (e) => {
            const { key, ctrlKey, metaKey, altKey } = e.originalEvent;
            if ((key === 'f' || key === 'F') && !ctrlKey && !metaKey && !altKey) toggleFullscreen();
          });
        },
      });
    }

    // 底部玻璃抽屉：收起时只露出拍摄信息，悬停 / 点击 / 按 i 键时向上滑出标题和说明
    lightbox.pswp?.ui?.registerElement({
      name: 'drawer',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (el, pswp) => {
        el.style.setProperty('--peek-h', `${PEEK_HEIGHT}px`);
        el.innerHTML = `
          <div class="drawer-peek">
            <span class="drawer-handle" aria-hidden="true"></span>
            <div class="drawer-meta"></div>
          </div>
          <div class="drawer-body"></div>`;
        const meta = el.querySelector<HTMLElement>('.drawer-meta')!;
        const body = el.querySelector<HTMLElement>('.drawer-body')!;

        const toggle = (open?: boolean) => {
          if (!el.classList.contains('has-note')) return;
          el.classList.toggle('is-open', open);
        };

        el.querySelector('.drawer-peek')!.addEventListener('click', () => toggle());
        // 全屏时点击屏幕底部的感应区（抽屉的 ::before）也能展开，方便触屏设备
        el.addEventListener('click', (e) => {
          if (e.target === el && document.fullscreenElement) toggle();
        });
        pswp.on('keydown', (e) => {
          if (e.originalEvent.key === 'i') toggle();
        });

        pswp.on('change', () => {
          const source = pswp.currSlide?.data.element;
          const note = source?.querySelector('.pswp-note-content');
          meta.innerHTML = source?.querySelector('.pswp-caption-content')?.innerHTML ?? '';
          body.innerHTML = note?.innerHTML ?? '';
          el.classList.toggle('has-note', !!note);
          if (!note) el.classList.remove('is-open');
        });
      },
    });
  });

  lightbox.init();

  // 网格排版：同一行等高并刚好铺满宽度，照片间距统一为 --gap；不同行的高度可以不同，
  // 每行选择最接近目标行高的照片张数。只有单张一行时限制最大高度（2 倍目标），此时这一行居中，
  // 多出的空间留在两侧页边。最后一行沿用上一行的高度、左对齐。没有 JS 时退回纯 CSS 的固定行高排版。
  const gallery = document.getElementById('gallery')!;
  const items = [...gallery.querySelectorAll<HTMLElement>('a.photo')].map((el) => ({
    el,
    ar: parseFloat(el.style.getPropertyValue('--ar')) || 1.5,
  }));

  function layout() {
    const style = getComputedStyle(gallery);
    const width = gallery.clientWidth - 0.5; // 留半像素余量，防止小数累计误差导致换行
    const gap = parseFloat(style.columnGap) || 0;
    const target = parseFloat(style.getPropertyValue('--row-height')) || 280;

    type Row = typeof items;
    const fitHeight = (row: Row) =>
      (width - gap * (row.length - 1)) / row.reduce((s, i) => s + i.ar, 0);

    // 多张一行时总是刚好铺满；单张一行（窄屏或超宽全景）最多放大到 2 倍目标高度
    const rowHeight = (row: Row) => (row.length === 1 ? Math.min(fitHeight(row), target * 2) : fitHeight(row));
    const deviation = (h: number) => Math.abs(Math.log(h / target));

    const place = (row: Row, height: number, center: boolean) => {
      const free = width - row.reduce((s, i) => s + i.ar * height, 0) - gap * (row.length - 1);
      row.forEach(({ el, ar }, i) => {
        el.style.width = `${ar * height}px`;
        el.style.height = `${height}px`;
        // 铺不满的行居中：多出的空间分到两侧页边，而不是加大照片间距
        el.style.marginLeft = center && i === 0 && free > 1 ? `${free / 2}px` : '';
      });
    };

    let row: Row = [];
    let lastHeight = target;
    for (const item of items) {
      const prev = row.length ? row.slice() : undefined;
      row.push(item);
      if (fitHeight(row) > target) continue;
      // 加入这张后行高低于目标：比较加与不加哪个更接近目标行高
      let finished = row;
      if (prev && deviation(rowHeight(prev)) < deviation(fitHeight(row))) {
        finished = prev;
        row = [item];
      } else {
        row = [];
      }
      lastHeight = rowHeight(finished);
      place(finished, lastHeight, true);
    }
    if (row.length) place(row, Math.min(lastHeight, fitHeight(row)), false);
    gallery.classList.add('is-justified');
  }

  // 只在容器宽度变化时重排（高度变化是排版本身造成的，不用管）
  let laidOutWidth = 0;
  const relayout = () => {
    if (gallery.clientWidth === laidOutWidth) return;
    laidOutWidth = gallery.clientWidth;
    layout();
  };
  relayout();
  new ResizeObserver(relayout).observe(gallery);
  window.addEventListener('resize', relayout);
</script>

<style>
  /* 没有 JS 时的退路：所有照片等高（--row-height），宽度按各自的宽高比，
     每行两端对齐（多余的空间平分到照片之间），--gap 是最小间距 */
  .gallery {
    --row-height: 280px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--gap);
  }
  /* 最后一行左对齐：用一个会伸展的占位元素吃掉最后一行剩下的空间 */
  .gallery::after {
    content: '';
    flex: 1 1 0;
  }
  @media (max-width: 640px) {
    .gallery { --row-height: 160px; }
  }
  /* JS 算好每张的尺寸后，照片紧挨着排，间距由 JS 控制 */
  .gallery.is-justified {
    justify-content: flex-start;
  }

  /* 全屏按钮：根据当前状态切换"进入 / 退出"图标 */
  :global(.pswp__button--fullscreen-button .pswp__icn) {
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.6));
  }
  :global(.pswp__button--fullscreen-button .fs-exit),
  :global(.pswp__button--fullscreen-button.is-active .fs-enter) {
    display: none;
  }
  :global(.pswp__button--fullscreen-button.is-active .fs-exit) {
    display: inline;
  }

  /* 底部玻璃抽屉：左右贴边，收起时只露出 --peek-h 的高度 */
  :global(.pswp__drawer) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* 不能设 overflow: hidden，否则全屏时位于抽屉上方的 ::before 感应区会被裁掉 */
    color: #f2f2f2;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    transform: translateY(calc(100% - var(--peek-h)));
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(.pswp__drawer.is-open) {
    transform: translateY(0);
  }
  @media (hover: hover) {
    :global(.pswp__drawer.has-note:hover) {
      transform: translateY(0);
    }
  }

  /* 全屏：抽屉完全藏到屏幕下方，鼠标移到底部感应区时整个滑出 */
  :global(html:fullscreen .pswp__drawer) {
    transform: translateY(100%);
  }
  :global(html:fullscreen .pswp__drawer::before) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 48px;
  }
  :global(html:fullscreen .pswp__drawer.is-open),
  :global(html:fullscreen .pswp__drawer:hover) {
    transform: translateY(0);
  }

  /* 收起时可见的一条：拍摄信息 */
  :global(.drawer-peek) {
    position: relative;
    height: var(--peek-h);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    text-align: center;
    user-select: none;
  }
  :global(.pswp__drawer.has-note .drawer-peek) { cursor: pointer; }
  :global(.drawer-meta) {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  :global(.drawer-meta p) { margin: 0; }

  /* 顶部的小把手，只在有说明时出现 */
  :global(.drawer-handle) {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 28px;
    height: 2px;
    margin-left: -14px;
    background: rgba(255, 255, 255, 0.45);
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.pswp__drawer.has-note .drawer-handle) { opacity: 1; }

  /* 展开后的内容：标题和说明 */
  :global(.drawer-body) {
    max-height: calc(45vh - var(--peek-h));
    overflow-y: auto;
    max-width: 640px;
    margin: 0 auto;
    padding: 8px 24px 36px;
    text-align: center;
  }
  :global(.drawer-body:empty) { display: none; }
  :global(.drawer-body h2) {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }
  /* 标题下的一条细线 */
  :global(.drawer-body h2:not(:last-child)::after) {
    content: '';
    display: block;
    width: 24px;
    height: 1px;
    margin: 14px auto;
    background: rgba(255, 255, 255, 0.6);
  }
  :global(.drawer-body p) {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.82);
  }
</style>
