---
import { SITE } from '../config';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={SITE.description} />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">{SITE.title}</a>
      <p class="site-desc">{SITE.description}</p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">© {new Date().getFullYear()} {SITE.author}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #111;
    --fg: #e8e8e8;
    --muted: #8a8a8a;
    --gap: 6px;
    font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--fg); }
  /* 预留滚动条位置，避免滚动条出现 / 消失时页面宽度跳动、相册反复重排 */
  html { scrollbar-gutter: stable; }
  a { color: inherit; }
  /* 页边距随窗口变宽：手机约 12px，宽屏最多 48px */
  main { padding: 0 clamp(12px, 3vw, 48px); }
  .site-header { padding: 40px 16px 28px; text-align: center; }
  .site-title { font-size: 1.6rem; font-weight: 600; letter-spacing: 0.08em; text-decoration: none; }
  .site-desc { margin: 8px 0 0; color: var(--muted); font-size: 0.9rem; }
  .site-footer { padding: 40px 16px; text-align: center; color: var(--muted); font-size: 0.8rem; }
</style>
