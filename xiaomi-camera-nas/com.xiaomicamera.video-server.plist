<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.xiaomicamera.video-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON3__</string>
		<string>-u</string>
		<string>__REPO_DIR__/server.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/Shared/XiaomiCamera/.remote-access/var/log/server-error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/Shared/XiaomiCamera/.remote-access/var/log/server.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__REPO_DIR__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XIAOMI_CAMERA_ROOT</key>
		<string>/Users/Shared/XiaomiCamera</string>
		<key>XIAOMI_CAMERA_STATE</key>
		<string>/Users/Shared/XiaomiCamera/.remote-access/var</string>
	</dict>
</dict>
</plist>
